{
  "name": "@vai/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "dev": "node --watch --import=tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "pnpm --filter @vai/observability build && pnpm --filter @vai/auth build && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vai/auth": "workspace:*",
    "@vai/config": "workspace:*",
    "@vai/contracts": "workspace:*",
    "@vai/database": "workspace:*",
    "@vai/observability": "workspace:*",
    "@vai/recommendation": "workspace:*",
    "fastify": "5.12.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "4.21.0",
    "typescript": "catalog:",
    "vitest": "4.1.10"
  }
}
